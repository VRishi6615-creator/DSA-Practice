class Solution {
    public int sumInRange(TreeNode root,int low,int high,int sum){
        if(root == null){
            return sum;
        }
        if(low <= root.val && root.val <= high){
            sum = sumInRange(root.left,low,high,sum);
            sum += root.val;
            sum = sumInRange(root.right,low,high,sum);
        }else if(low > root.val){
            sum = sumInRange(root.right,low,high,sum);
        }else{
            sum = sumInRange(root.left,low,high,sum);
        }
        return sum;
    }
    public int rangeSumBST(TreeNode root, int low, int high) {
        int sum = 0;
        int ans = sumInRange(root,low,high,sum);
        return ans;
    }
}
